# EvalShield 文章生成器环境变量示例
# 复制为 .env 或直接 export。仅 --mock / --dry-run 不需要 KEY。

# --- LLM（OpenAI 兼容端点，DeepSeek/通义/OpenAI 皆可）---
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-在这里填你的密钥
OPENAI_MODEL=deepseek-chat
OPENAI_TEMPERATURE=0.85
OPENAI_MAX_TOKENS=2600
OPENAI_TIMEOUT=120

# 注：短文案脚本不再注入任何 CTA/联系方式（全文禁品牌名与联系方式），
# 人工发布时按平台规则自行补评论区/私信引导。故此处无需 CONTACT_*/LANDING_URL。
