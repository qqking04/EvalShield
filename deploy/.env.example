# EvalShield 部署环境变量模板 —— cp deploy/.env.example .env 后逐项填写
# 【必填】JWT 签名密钥：生成命令 openssl rand -hex 32
EVALSHIELD_SECRET_KEY=
# 【选填】云模型密钥（DeepSeek）。留空=全离线/内网 Ollama 模式，AI 判定引擎走内置规则兜底
DEEPSEEK_API_KEY=
# 【选填】PostgreSQL 口令（默认 EvalShield；交付验收前必须改强口令，self-check.sh 会 WARN）
EVALSHIELD_DB_PASSWORD=EvalShield
# 【选填】CORS 白名单，多个逗号分隔
EVALSHIELD_CORS_ORIGINS=http://localhost:8080
# 【选填】JMeter 宿主机目录（见 W3；默认 ./deploy/jmeter，开发机可指向本地安装目录）
JMETER_HOST_DIR=./deploy/jmeter
# 【选填】端口
EVALSHIELD_BACKEND_PORT=8000
EVALSHIELD_FRONTEND_PORT=8891
EVALSHIELD_SANDBOX_PORT=9000
# 【选填】ES9-P-14 监控/告警：/metrics 开关 + Bearer 令牌（生产务必填强随机值）
METRICS_ENABLED=false
METRICS_TOKEN=
# 【选填】watchdog 告警推送（企业微信机器人 webhook；留空=仅本地日志）
NOTIFY_WEBHOOK_URL=
