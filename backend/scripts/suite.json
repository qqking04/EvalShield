{
  "source_type": "CSV",
  "source_ref": "/tmp/dataq_test/customer_orders.csv",
  "severity": "NORMAL",
  "suite_name": "电商订单数据质量测试套件",
  "expectations": [
    {
      "type": "expect_column_values_to_not_be_null",
      "column": "order_id"
    },
    {
      "type": "expect_column_values_to_be_unique",
      "column": "order_id"
    },
    {
      "type": "expect_column_values_to_not_be_null",
      "column": "customer_name"
    },
    {
      "type": "expect_column_values_to_match_regex",
      "column": "phone",
      "regex": "^1[3-9]\\d{9}$"
    },
    {
      "type": "expect_column_values_to_match_regex",
      "column": "email",
      "regex": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
    },
    {
      "type": "expect_column_values_to_be_between",
      "column": "quantity",
      "min_value": 1,
      "max_value": 999
    },
    {
      "type": "expect_column_values_to_not_be_null",
      "column": "total_amount"
    },
    {
      "type": "expect_column_values_to_be_between",
      "column": "total_amount",
      "min_value": 0,
      "max_value": 1000000
    },
    {
      "type": "expect_column_values_to_be_in_set",
      "column": "order_status",
      "value_set": [
        "COMPLETED",
        "SHIPPED",
        "PENDING",
        "CANCELLED",
        "REFUNDED"
      ]
    },
    {
      "type": "expect_column_values_to_not_be_null",
      "column": "product_sku"
    },
    {
      "type": "expect_table_row_count_to_be_between",
      "min_value": 20,
      "max_value": 10000
    },
    {
      "type": "expect_table_columns_to_match_ordered_list",
      "column_list": [
        "order_id",
        "customer_id",
        "customer_name",
        "phone",
        "email",
        "product_sku",
        "product_name",
        "quantity",
        "unit_price",
        "total_amount",
        "order_status",
        "payment_method",
        "order_date",
        "shipping_city",
        "shipping_address"
      ]
    }
  ]
}