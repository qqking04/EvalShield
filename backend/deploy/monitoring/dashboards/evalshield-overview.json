{
  "uid": "evalshield-overview",
  "title": "EvalShield 总览",
  "tags": ["evalshield", "es9-p14"],
  "timezone": "asia/shanghai",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API QPS 与 5xx 错误率",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "evalshield-prom" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "5xx 错误率" },
            "properties": [{ "id": "unit", "value": "percentunit" }, { "id": "custom.axisPlacement", "value": "right" }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{handler!=\"none\"}[5m]))",
          "legendFormat": "QPS"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx 错误率"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "沙箱队列深度",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "evalshield-prom" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "evalshield_sandbox_queue_depth",
          "legendFormat": "queue depth"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "LLM token 日耗（按模型/类型）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "evalshield-prom" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(evalshield_llm_tokens_total[1d])) by (model, kind)",
          "legendFormat": "{{model}} / {{kind}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "沙箱执行耗时 P95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "evalshield-prom" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(evalshield_sandbox_exec_seconds_bucket[10m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum(rate(evalshield_sandbox_exec_seconds_bucket[10m])) by (le))",
          "legendFormat": "P50"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "磁盘水位（证据卷字节 / 卷用量告警见 RUNBOOK）",
      "description": "evalshield_evidence_dir_bytes：证据目录占用。卷使用率 >90% 时 /api/healthz 返回 503；建议配 node_exporter 后叠加 filesystem 面板。",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "evalshield-prom" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 42949672960 },
              { "color": "red", "value": 85899345920 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "evalshield_evidence_dir_bytes",
          "legendFormat": "evidence dir"
        }
      ]
    }
  ]
}
