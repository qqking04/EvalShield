# ===== EvalShield 后端环境变量样例 =====
# 复制为 backend/.env 后按需修改。默认值即可在本机运行。

# 应用
DEBUG=true
SECRET_KEY=EvalShield-dev-secret-change-me-in-prod-2026
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库（本机已创建：库/用户/密码均为 EvalShield，UTF-8）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=EvalShield
DB_USER=EvalShield
DB_PASSWORD=EvalShield

# 登录安全策略
LOGIN_FAIL_LIMIT=10
LOGIN_LOCK_MINUTES=5
PASSWORD_EXPIRE_DAYS=90
PASSWORD_MIN_LENGTH=8

# 模型网关（FR-15）
MODEL_PROVIDERS={}
MODEL_CACHE_POLICY=CONTENT_HASH
GATEWAY_REQUEST_LIMIT_PER_MIN=60
ENABLE_LOCAL_MODELS=false

# 分布式锁（多实例部署时防止定时任务重复触发）
# 格式：redis://:password@host:6379/0  或  redis://host:6379/0
REDIS_URL=

# 任务/执行
TASK_TIMEOUT_SECONDS=900
ENGINE_REDTEAM_STRICT=true

# 通知（FR-20）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
WEBHOOK_SECRET=EvalShield-webhook-secret-dev

# 证据与报告目录
EVIDENCE_DIR=
REPORT_DIR=

# 前端跨域
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 沙箱隔离（Sandbox） ----
SANDBOX_ENABLED=false
SANDBOX_HOST=evalshield-sandbox
SANDBOX_PORT=9000
SANDBOX_USE_UNIX_SOCKET=false
SANDBOX_UNIX_SOCKET=/var/run/evalshield/sandbox.sock
SANDBOX_REQUEST_TIMEOUT=30
SANDBOX_WORKER_IMAGE=sandbox-worker:latest
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEM_LIMIT=512m
SANDBOX_PIDS_LIMIT=64
SANDBOX_TMPFS_SIZE=64m
SANDBOX_SECCOMP_PROFILE=/app/seccomp-default.json
SANDBOX_DEFAULT_TIMEOUT=300
SANDBOX_MAX_TIMEOUT=1800
SANDBOX_LOG_MAX_BYTES=2097152